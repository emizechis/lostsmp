rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Troque pelo e-mail Google do admin (o mesmo de adminEmail no index.html)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'SEU_EMAIL@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /players/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.nome is string
        && request.resource.data.nome.size() <= 16
        && request.resource.data.tag in ['Dono', 'Admin', 'Jogador']
        && request.resource.data.keys().hasOnly(['nome', 'tag', 'bio', 'criadoEm']);
      allow delete: if isAdmin();
    }
  }
}
